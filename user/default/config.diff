# 官方 MX4200v1/v2 默认包与依赖由设备定义提供
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v2=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# 构建开关
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_FEED_video=n

# Official device hci-uart dependency is selected by the MX4200 device profile.

# 中文管理界面；luci 自带防火墙和软件包管理器
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
# 概览温度采集及既有三无线传感器修正
CONFIG_PACKAGE_autocore=y

# 本地编译应用；ttyd、etherwake 等依赖由包配方提供
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y

# Honk 与 Aurora 使用官方签名 APK 预装，不选择外部源码包
# 外部 APK 所需的本地运行库、内核模块与规则数据
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# Honk eBPF CO-RE、cgroup 与网络命名空间支持
# BPF / BPF_JIT / BPF_SYSCALL 沿用官方 generic 内核配置
# Honk 使用同次构建的外置 BTF，避免撑大 MX4200 的 6 MiB 内核分区
CONFIG_DWARVES=y
CONFIG_PACKAGE_vmlinux-btf=y
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y

# 明确排除，不继承旧项目其他软件包取舍
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n

# Official external bootstrap from the Debian ARM64 builder
# CONFIG_GOLANG_BUILD_BOOTSTRAP is not set
CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/lib/go"
