From 1698cc246e28cf9f68e5ac4131a20b757728fe49 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 15 Nov 2026 10:58:40 +0100
Subject: [PATCH] qualcommax: qca_edma: take receive buffers from 2 KB page
 fragments

A receive buffer is a whole page whatever the frame size. At MTU 1500 the
headroom, the longest frame the pool syncs and the shared info end at
about 1.9 KB, so half of every 4 KB page, and of the 32 MB that four
2048-entry fill rings pin, is never written.

Take the buffers from 2 KB fragments of a page when headroom, longest frame
and shared info fit in 2 KB, which holds up to MTU 1610, and from whole
pages as before above it, so jumbo frames are unchanged. The pool syncs a
page for the device when its last fragment returns, so its sync length now
runs from the first buffer's preheader to the end of the last buffer's
longest frame. A buffer records its offset in the page, which the
descriptor address, the skb head and the shared info prefetch are taken
from.

A fill ring of 512 entries is enough for the smaller buffers and the
interrupt moderation in place: one ring set alone absorbs 6 ms of a full
gigabit of 1514-byte frames, and the frames hash over four sets. The
pinned buffers go from 32 MB to 4 MB (four sets of 512 buffers of 2 KB
instead of 2048 of 4 KB); ethtool -G still sets any size.

A fill buffer is now 1664 bytes where it was 3712, so a frame the PPE
redirects to the CPU between those sizes is split over several descriptors
where it used to be dropped whole as too long. The driver drops such a run
whole since the previous change.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>

Backport: Keep the existing consumer-index refill, coherent descriptor rings,
and fixed interrupt moderation. Keep four queues and existing ethtool
ring-size limits. On the reviewed 4 KiB-page target, a larger buffer
uses whole (possibly compound) pages as before.
---
--- a/target/linux/qualcommax/files/drivers/net/ethernet/qualcomm/qca_edma.c
+++ b/target/linux/qualcommax/files/drivers/net/ethernet/qualcomm/qca_edma.c
@@ -276,6 +276,7 @@
 	struct page *page;
 	u16 filled = 0;
 	dma_addr_t dma;
+	unsigned int off, size;
 
 	prod = q->rxfill_prod;
 	cons = edma_idx_read(priv, EDMA_REG_RXFILL_CONS_IDX(q->rxfill)) &
@@ -292,15 +293,17 @@
 		if (unlikely(rxfill_ring->rx_store[prod].page))
 			break;
 
-		page = page_pool_dev_alloc_pages(q->page_pool);
+		size = priv->rx_truesize;
+		page = page_pool_dev_alloc(q->page_pool, &off, &size);
 		if (unlikely(!page))
 			break;
 
 		rxfill_desc = EDMA_RXFILL_DESC(rxfill_ring, prod);
 
-		dma = page_pool_get_dma_addr(page);
+		dma = page_pool_get_dma_addr(page) + off;
 		rxfill_ring->rx_store[prod].page = page;
 		rxfill_ring->rx_store[prod].dma = dma;
+		rxfill_ring->rx_store[prod].off = off;
 		rxfill_desc->buffer_addr = cpu_to_le32(dma + NET_SKB_PAD);
 		rxfill_desc->word1 = cpu_to_le32(priv->rx_buffer_size &
 						 EDMA_RXFILL_BUF_SIZE_MASK);
@@ -702,10 +705,10 @@
 	pk->buf = buf;
 	__page_pool_dma_sync_for_cpu(q->page_pool, buf->dma, 0,
 				     edma_rx_sync_len(q, pk->status));
-	data = page_address(buf->page);
+	data = page_address(buf->page) + buf->off;
 	prefetch(data + NET_SKB_PAD);
 	prefetch(data + NET_SKB_PAD + L1_CACHE_BYTES);
-	prefetchw(data + (PAGE_SIZE << q->priv->rx_page_order) -
+	prefetchw(data + q->priv->rx_truesize -
 		  SKB_DATA_ALIGN(sizeof(struct skb_shared_info)));
 }
 
@@ -718,6 +721,7 @@
 	struct edma_rx_preheader *rxph;
 	struct edma_rx_peek cur, nxt;
 	unsigned char *frame;
+	void *data;
 	bool ahead = false;
 	struct sk_buff *skb;
 	u16 prod, cons;
@@ -783,7 +787,8 @@
 		}
 		page = buf->page;
 		buf->page = NULL;
-		rxph = page_address(page) + NET_SKB_PAD;
+		data = page_address(page) + buf->off;
+		rxph = data + NET_SKB_PAD;
 
 		if (unlikely(drop)) {
 			page_pool_put_full_page(q->page_pool, page, true);
@@ -813,8 +818,7 @@
 
 		src_port = rxph->src_info & EDMA_SRC_PORT_MASK;
 
-		skb = napi_build_skb(page_address(page),
-				     PAGE_SIZE << priv->rx_page_order);
+		skb = napi_build_skb(data, priv->rx_truesize);
 		if (unlikely(!skb)) {
 			page_pool_put_full_page(q->page_pool, page, true);
 			q->stats.rx_no_skb++;
@@ -2318,30 +2322,51 @@
 	return EDMA_RX_PREHDR_SIZE + mtu + ETH_HLEN + 2 * VLAN_HLEN;
 }
 
-static u8 edma_rx_page_order(int mtu)
-{
-	return get_order(NET_SKB_PAD + edma_rx_frame_len(mtu) +
-			 SKB_DATA_ALIGN(sizeof(struct skb_shared_info)));
-}
-
-static u32 edma_rx_buffer_size(u8 order)
-{
-	return (PAGE_SIZE << order) - NET_SKB_PAD -
+/* The memory a receive buffer takes: headroom, the longest frame and the
+ * shared info the skb is built with. One that fits half a page is a fragment
+ * of a page, one that does not takes whole pages.
+ */
+static u32 edma_rx_truesize(int mtu)
+{
+	u32 need = NET_SKB_PAD + edma_rx_frame_len(mtu) +
+		   SKB_DATA_ALIGN(sizeof(struct skb_shared_info));
+
+	if (need <= EDMA_RX_FRAG_SIZE)
+		return EDMA_RX_FRAG_SIZE;
+
+	return PAGE_SIZE << get_order(need);
+}
+
+static u32 edma_rx_buffer_size(u32 truesize)
+{
+	return truesize - NET_SKB_PAD -
 	       SKB_DATA_ALIGN(sizeof(struct skb_shared_info));
 }
 
+/* The pool syncs, for the device, from the start of the first buffer's
+ * preheader to the end of the last buffer's longest frame, as a page comes
+ * back from its last user.
+ */
+static u32 edma_rx_sync_span(u32 truesize, u32 frame_len)
+{
+	u32 order_size = PAGE_SIZE << get_order(truesize);
+
+	return order_size - truesize + frame_len;
+}
+
 static struct page_pool *edma_page_pool_create(struct edma_priv *priv,
-					       u8 order, u32 len, u16 size,
+					       u32 truesize, u32 frame_len,
+					       u16 size,
 					       struct napi_struct *napi)
 {
 	struct page_pool_params pp = {
-		.order     = order,
+		.order     = get_order(truesize),
 		.pool_size = size,
 		.nid       = NUMA_NO_NODE,
 		.dev       = &priv->pdev->dev,
 		.dma_dir   = DMA_FROM_DEVICE,
 		.offset    = NET_SKB_PAD,
-		.max_len   = len,
+		.max_len   = edma_rx_sync_span(truesize, frame_len),
 		.flags     = PP_FLAG_DMA_MAP | PP_FLAG_DMA_SYNC_DEV,
 		.napi      = napi,
 	};
@@ -2357,14 +2382,15 @@
 		page_pool_destroy(pools[i]);
 }
 
-static int edma_page_pools_create(struct edma_priv *priv, int mtu, u16 size,
-				  struct page_pool **pools, unsigned int n)
+static int edma_page_pools_create(struct edma_priv *priv, int mtu, u32 truesize,
+				  u16 size, struct page_pool **pools,
+				  unsigned int n)
 {
 	unsigned int i;
 
 	memset(pools, 0, EDMA_MAX_QUEUES * sizeof(*pools));
 	for (i = 0; i < n; i++) {
-		pools[i] = edma_page_pool_create(priv, edma_rx_page_order(mtu),
+		pools[i] = edma_page_pool_create(priv, truesize,
 						 edma_rx_frame_len(mtu), size,
 						 &priv->q[i].napi);
 		if (IS_ERR(pools[i])) {
@@ -2408,15 +2434,16 @@
 	struct page_pool *pools[EDMA_MAX_QUEUES];
 	struct net_device *netdev = priv->netdev;
 	unsigned int old_nq = priv->num_queues;
-	u8 old_order = priv->rx_page_order;
+	u32 old_truesize = priv->rx_truesize;
 	u32 old_len = priv->rx_frame_len;
+	u32 truesize = edma_rx_truesize(mtu);
 	u16 old_tx = priv->tx_ring_size;
 	u16 old_rx = priv->rx_ring_size;
 	unsigned int i;
 	bool running;
 	int ret;
 
-	ret = edma_page_pools_create(priv, mtu, rx_size, pools, nq);
+	ret = edma_page_pools_create(priv, mtu, truesize, rx_size, pools, nq);
 	if (ret)
 		return ret;
 
@@ -2436,8 +2463,8 @@
 
 	edma_page_pools_swap(priv, pools);
 	priv->num_queues = nq;
-	priv->rx_page_order = edma_rx_page_order(mtu);
-	priv->rx_buffer_size = edma_rx_buffer_size(priv->rx_page_order);
+	priv->rx_truesize = truesize;
+	priv->rx_buffer_size = edma_rx_buffer_size(truesize);
 	priv->rx_frame_len = edma_rx_frame_len(mtu);
 	priv->tx_ring_size = tx_size;
 	priv->rx_ring_size = rx_size;
@@ -2448,8 +2475,8 @@
 
 		edma_page_pools_swap(priv, pools);
 		priv->num_queues = old_nq;
-		priv->rx_page_order = old_order;
-		priv->rx_buffer_size = edma_rx_buffer_size(old_order);
+		priv->rx_truesize = old_truesize;
+		priv->rx_buffer_size = edma_rx_buffer_size(old_truesize);
 		priv->rx_frame_len = old_len;
 		priv->tx_ring_size = old_tx;
 		priv->rx_ring_size = old_rx;
@@ -2660,11 +2687,11 @@
 						   USEC_PER_SEC);
 	priv->rx_ugt_thre = EDMA_COAL_FRAMES - 1;
 	priv->tx_ugt_thre = EDMA_COAL_FRAMES - 1;
-	priv->rx_page_order = edma_rx_page_order(netdev->mtu);
-	priv->rx_buffer_size = edma_rx_buffer_size(priv->rx_page_order);
+	priv->rx_truesize = edma_rx_truesize(netdev->mtu);
+	priv->rx_buffer_size = edma_rx_buffer_size(priv->rx_truesize);
 	priv->rx_frame_len = edma_rx_frame_len(netdev->mtu);
-	ret = edma_page_pools_create(priv, netdev->mtu, priv->rx_ring_size,
-				     pools, nq);
+	ret = edma_page_pools_create(priv, netdev->mtu, priv->rx_truesize,
+				     priv->rx_ring_size, pools, nq);
 	if (ret)
 		return ret;
 	edma_page_pools_swap(priv, pools);
--- a/target/linux/qualcommax/files/drivers/net/ethernet/qualcomm/qca_edma.h
+++ b/target/linux/qualcommax/files/drivers/net/ethernet/qualcomm/qca_edma.h
@@ -206,7 +206,9 @@
 		      (2 * VLAN_HLEN))
 #define EDMA_TX_PREHDR_SIZE	(sizeof(struct edma_tx_preheader))
 #define EDMA_TX_RING_SIZE	128
-#define EDMA_RX_RING_SIZE	2048
+#define EDMA_RX_RING_SIZE	512
+/* Half of a 4 KiB page: two receive buffers can share one page. */
+#define EDMA_RX_FRAG_SIZE	2048
 /* The bounds a frame is described to the engine within: at most this many
  * buffers, and no buffer below this size before the last. The queue stops
  * with room for a frame that takes every descriptor, or it would restart on
@@ -217,8 +219,8 @@
 #define EDMA_TX_RING_THRESH	(EDMA_TX_MAX_SEGS + 1)
 
 /* A ring index wraps by masking, so a ring is a power of two. The size
- * registers are sixteen bits wide, but a fill ring pins a page per entry and
- * the ceiling below is that, not the field.
+ * registers are sixteen bits wide, but the ceiling also bounds the amount
+ * of memory pinned by an RX fill ring.
  */
 #define EDMA_MIN_RING_SIZE	64
 #define EDMA_MAX_RING_SIZE	8192
@@ -336,6 +338,7 @@
 struct edma_rx_buf {
 	struct page *page;
 	dma_addr_t dma;
+	u32 off;
 };
 
 struct edma_ring {
@@ -413,7 +416,7 @@
 	struct reset_control *rst;
 	u32 rx_buffer_size;
 	u32 rx_frame_len;
-	u8 rx_page_order;
+	u32 rx_truesize;
 	u16 tx_ring_size;
 	u16 rx_ring_size;
 	unsigned long clk_rate;
