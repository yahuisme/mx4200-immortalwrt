#!/bin/sh
# MX4200: use named CPU/ath11k sensors, never unstable hwmon indices.
{
	for sensor in /sys/class/hwmon/hwmon*; do
		name="$(cat "$sensor/name" 2>/dev/null)"
		case "$name" in
			cluster_thermal|cpu[0-9]*_thermal|ath11k_hwmon) ;;
			*) continue ;;
		esac
		value="$(cat "$sensor/temp1_input" 2>/dev/null)" || continue
		case "$value" in
			''|*[!0-9]*) continue ;;
		esac
		printf '%s %s\n' "$name" "$value"
	done
} | awk '
$1 == "cluster_thermal" { cluster = $2; has_cluster = 1 }
$1 ~ /^cpu[0-9]+_thermal$/ { if (!has_cpu || $2 > cpu) cpu = $2; has_cpu = 1 }
$1 == "ath11k_hwmon" {
	wifi = wifi (wifi ? " " : "") sprintf("%.1f°C", $2 / 1000)
}
END {
	if (has_cluster || has_cpu)
		printf "CPU: %.1f°C", (has_cluster ? cluster : cpu) / 1000
	if (wifi)
		printf "%sWiFi: %s", (has_cluster || has_cpu) ? ", " : "", wifi
	if (!has_cluster && !has_cpu && !wifi)
		printf "No temperature info"
}'
